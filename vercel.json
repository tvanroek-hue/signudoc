{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "next build && node db/migrate.mjs --optional",
  "crons": [
    {
      "path": "/api/internal/retention",
      "schedule": "0 9 * * *"
    },
    {
      "path": "/api/internal/backup",
      "schedule": "0 8 * * *"
    },
    {
      "path": "/api/internal/webhooks",
      "schedule": "30 9 * * *"
    },
    {
      "path": "/api/internal/signing-email",
      "schedule": "*/5 * * * *"
    }
  ]
}
